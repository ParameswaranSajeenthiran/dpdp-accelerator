<DPDPAccelerator xmlns="http://wso2.org/projects/carbon/dpdp-accelerator.xml"
                 xmlns:svns="http://org.wso2.securevault/configuration">
    <ConsentPortal>
        {% if dpdp_accelerator.consent_portal.auto_provisioning_enabled is defined %}
        <AutoProvisioningEnabled>{{dpdp_accelerator.consent_portal.auto_provisioning_enabled}}</AutoProvisioningEnabled>
        {% else %}
        <AutoProvisioningEnabled>true</AutoProvisioningEnabled>
        {% endif %}
        {% if dpdp_accelerator.consent_portal.client_id is defined %}
        <ClientId>{{dpdp_accelerator.consent_portal.client_id}}</ClientId>
        {% else %}
        <ClientId>DPDP_CONSENT_PORTAL</ClientId>
        {% endif %}
    </ConsentPortal>
    <ConsentHistory>
        {% if dpdp_accelerator.consent_history.enabled is defined %}
        <Enabled>{{dpdp_accelerator.consent_history.enabled}}</Enabled>
        {% else %}
        <Enabled>true</Enabled>
        {% endif %}
        {% if dpdp_accelerator.consent_history.snapshot_enabled is defined %}
        <SnapshotEnabled>{{dpdp_accelerator.consent_history.snapshot_enabled}}</SnapshotEnabled>
        {% else %}
        <SnapshotEnabled>true</SnapshotEnabled>
        {% endif %}
        {% if dpdp_accelerator.consent_history.data_source_name is defined %}
        <DataSourceName>{{dpdp_accelerator.consent_history.data_source_name}}</DataSourceName>
        {% else %}
        <DataSourceName>jdbc/WSO2DPDP_DB</DataSourceName>
        {% endif %}
    </ConsentHistory>
    <ConsentExpiry>
        {% if dpdp_accelerator.consent_expiry.enabled is defined %}
        <Enabled>{{dpdp_accelerator.consent_expiry.enabled}}</Enabled>
        {% else %}
        <Enabled>true</Enabled>
        {% endif %}
        {% if dpdp_accelerator.consent_expiry.cron_value is defined %}
        <CronValue>{{dpdp_accelerator.consent_expiry.cron_value}}</CronValue>
        {% else %}
        <CronValue>0 0 0 * * ?</CronValue>
        {% endif %}
        {% if dpdp_accelerator.consent_expiry.batch_size is defined %}
        <BatchSize>{{dpdp_accelerator.consent_expiry.batch_size}}</BatchSize>
        {% else %}
        <BatchSize>100</BatchSize>
        {% endif %}
    </ConsentExpiry>
</DPDPAccelerator>

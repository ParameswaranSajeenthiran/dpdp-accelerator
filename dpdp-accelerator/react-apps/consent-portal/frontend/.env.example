# Absolute base URL of the Identity Server, for running the SPA outside the
# server (npm run dev). Leave empty when the portal is deployed inside the
# Identity Server: the APIs are then same-origin and tenant-qualified, exactly
# like the page itself.
VITE_API_BASE_URL=
# Public base path the SPA is served from (Vite `base`).
VITE_BASE_PATH=/consent-portal/
# Set to false to run the UI without signing in (development only).
VITE_AUTH_ENABLED=true

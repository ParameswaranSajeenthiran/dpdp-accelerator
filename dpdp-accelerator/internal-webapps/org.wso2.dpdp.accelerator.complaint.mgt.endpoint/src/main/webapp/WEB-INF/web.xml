<!--
  Authentication and scope enforcement (complaints:read:self etc.) happen before a request ever
  reaches this servlet - they're handled by the Identity Server's own OAuth2 valve, gated by
  [[resource.access_control]] entries in deployment.toml keyed on this webapp's context path. No
  auth filter is declared here, matching how the product's own SCIM2/health-check webapps are
  wired, and how consent.mgt.extensions.endpoint is wired.
-->
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
         http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" metadata-complete="true">
    <absolute-ordering/>

    <display-name>WSO2 DPDP Complaint Server</display-name>

    <servlet>
        <servlet-name>CXFServlet</servlet-name>
        <servlet-class>org.apache.cxf.jaxrs.servlet.CXFNonSpringJaxrsServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
        <init-param>
            <param-name>jaxrs.serviceClasses</param-name>
            <param-value>
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.api.ComplaintEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.api.ComplaintTimelineEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.api.ComplaintCommentEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.api.ComplaintAttachmentEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.api.MeComplaintEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.api.MeComplaintTimelineEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.api.MeComplaintCommentEndpoint,
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.api.MeComplaintAttachmentEndpoint
            </param-value>
        </init-param>
        <init-param>
            <param-name>jaxrs.providers</param-name>
            <param-value>
                org.wso2.dpdp.accelerator.complaint.mgt.endpoint.exception.ComplaintExceptionMapper,
                com.fasterxml.jackson.jaxrs.json.JacksonJsonProvider,
                org.apache.cxf.jaxrs.provider.MultipartProvider
            </param-value>
        </init-param>
    </servlet>

    <servlet-mapping>
        <servlet-name>CXFServlet</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>
</web-app>

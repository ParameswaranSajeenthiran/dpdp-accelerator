<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wso2.dpdp.accelerator</groupId>
        <artifactId>dpdp-accelerator</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>org.wso2.dpdp.accelerator.complaint.mgt.endpoint</artifactId>
    <packaging>war</packaging>

    <name>WSO2 DPDP Accelerator - Complaint Management Endpoint</name>

    <dependencies>
        <!--
             Now an OSGi bundle deployed separately into dropins (resolved at runtime via
             getOSGiService(...) in each handler's no-arg constructor), not bundled into this
             WAR - provided scope so Maven doesn't also package a second, distinct copy of these
             classes into WEB-INF/lib (which would break the OSGi service casts with a
             ClassCastException across two different classloaders' copies of the same class).
             Same reasoning as event-notifications.service's provided scope in that endpoint's pom.
        -->
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.complaint.mgt.service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ConfigProvider, used by config-loading elsewhere in this module -->
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- PrivilegedCarbonContext, used by every endpoint class to resolve the caller's identity
             directly - Carbon's own valve pipeline populates this per-request, even for a
             plain-WAR webapp like this one (confirmed empirically). Provided at runtime by
             Carbon's shared classloader (this webapp's Environments includes Carbon - see
             webapp-classloading.xml), never bundled into the WAR. -->
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.utils</artifactId>
        </dependency>

        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>

        <!-- Everything below is supplied at runtime by <IS_HOME>/lib/runtimes/cxf3/, the "CXF3"
             webapp-classloading environment declared in META-INF/webapp-classloading.xml - these
             are compile-time-only, pinned to that directory's exact shipped versions (the pinning
             itself lives in the root pom's dependencyManagement). Same pattern as
             consent.mgt.extensions.endpoint's pom. -->
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-frontend-jaxrs</artifactId>
            <exclusions>
                <!-- Also shadows javax.ws.rs-api 2.1.1's javax.ws.rs.core.Response with its own
                     copy of the same package. -->
                <exclusion>
                    <groupId>jakarta.ws.rs</groupId>
                    <artifactId>jakarta.ws.rs-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- org.apache.cxf.jaxrs.ext.multipart.{Attachment,Multipart,ContentDisposition} - used by
             ComplaintAttachmentEndpoint/MeComplaintAttachmentEndpoint's file upload parameters. -->
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-rs-extension-providers</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.jaxrs</groupId>
            <artifactId>jackson-jaxrs-json-provider</artifactId>
        </dependency>

        <!-- Servlet API - provided by the container at runtime -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
             Test-only: MultipartFileBindingTest starts a real, in-process CXF JAX-RS server and
             drives it with CXF's own client, to test CXF's actual multipart binding behavior
             (does @Multipart("file") List<Attachment> actually collect every part sharing that
             field name, or only the first/last?) end-to-end rather than relying on assumptions -
             none of the other endpoint/handler tests ever exercise the real HTTP/multipart parsing
             layer, so that binding behavior has no coverage without this. Not part of the deployed
             WAR - cxf-rt-frontend-jaxrs above is compile-time-only (provided by the CXF3 runtime
             environment at deploy time), but the test JVM needs an actual client implementation on
             its classpath to drive requests against the in-process server.
        -->
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-rs-client</artifactId>
            <version>${cxf.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>api#dpdp#complaints#v1</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wso2.dpdp.accelerator</groupId>
        <artifactId>dpdp-accelerator</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>org.wso2.dpdp.accelerator.complaint.mgt.endpoint</artifactId>
    <packaging>war</packaging>

    <name>WSO2 DPDP Accelerator - Complaint Management Endpoint</name>

    <dependencies>
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.accelerator.complaint.mgt.service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ConfigProvider, used by config-loading elsewhere in this module -->
        <dependency>
            <groupId>org.wso2.dpdp.accelerator</groupId>
            <artifactId>org.wso2.dpdp.common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- PrivilegedCarbonContext, used by auth/TokenIntrospectionClient.java to resolve the
             caller's identity - Carbon's own valve pipeline populates this per-request, even for
             a plain-WAR webapp like this one (confirmed empirically). Provided at runtime by
             Carbon's shared classloader (this webapp's Environments includes Carbon - see
             webapp-classloading.xml), never bundled into the WAR. -->
        <dependency>
            <groupId>org.wso2.carbon</groupId>
            <artifactId>org.wso2.carbon.utils</artifactId>
        </dependency>

        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>

        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
        </dependency>

        <!-- Jersey Servlet Container -->
        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-servlet-core</artifactId>
        </dependency>
        <!--
             The root pom's dependencyManagement pins jersey-common to `test` scope (for
             event-notifications' own test-only usage), which otherwise drags this transitive
             dependency of jersey-container-servlet-core down to `test` scope here too, excluding
             it from WEB-INF/lib and causing NoClassDefFoundError: ExtendedLogger on deploy.
             Overridden back to compile scope for this module explicitly.
        -->
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-common</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>

        <!-- Multipart form support (file uploads) -->
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-multipart</artifactId>
        </dependency>

        <!--
             Not used directly by this app's code, but jersey-server's WebTargetValueParamProvider
             (part of its @Uri-injection support) does an eager static class-load of this package's
             ClientConfig during ServletContainer init, regardless of whether @Uri injection is
             actually used - omitting it from the WAR causes a NoClassDefFoundError on deploy.
        -->
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-client</artifactId>
        </dependency>

        <!-- Servlet API - provided by the container at runtime -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Database drivers -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
             In-memory HTTP server + client for a real, non-mocked test of Jersey's own multipart
             binding (does @FormDataParam("file") List<FormDataBodyPart> actually collect every
             part sharing that field name, or only the first/last?) - the existing endpoint tests
             all construct FormDataBodyPart lists directly in Java and never exercise the real
             HTTP/multipart parsing layer at all, so that binding behavior has no coverage without
             this. Driven directly via GrizzlyHttpServerFactory rather than JerseyTest - JerseyTest's
             own dynamic-port setUp() reliably threw BindException on this machine (it appears to
             probe for a free port with one throwaway container, then start a second real one on
             that same port before the first has released it). Test-scope only; not part of the
             deployed WAR.
        -->
        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-grizzly2-http</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>api#dpdp#complaints#v1</finalName>
    </build>

</project>
